# GoDaddy SMTP Configuration
# Copy this file to .env.local and fill in your actual credentials
GODADDY_SMTP_HOST=smtp.godaddy.com
GODADDY_SMTP_PORT=465
GODADDY_SMTP_USER=management@estatement.in
GODADDY_SMTP_PASS=your-godaddy-smtp-password-here

# Receiver email for inquiries
RECEIVER_EMAIL=management@estatement.in
